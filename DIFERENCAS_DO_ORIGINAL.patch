+void Simulation::paintTrack(glm::vec2 point) {
+    constexpr float radius=.25f;
+    glm::vec2 pixel=(point/terrainSize+.5f)*float(textureSize)-.5f;
+    float r=radius*textureSize/terrainSize;
+    int x0=std::max(0,int(std::floor(pixel.x-r))),x1=std::min(textureSize-1,int(std::ceil(pixel.x+r)));
+    int z0=std::max(0,int(std::floor(pixel.y-r))),z1=std::min(textureSize-1,int(std::ceil(pixel.y+r)));
+    for(int z=z0;z<=z1;z++)for(int x=x0;x<=x1;x++) {
+        float d=glm::length(glm::vec2(float(x),float(z))-pixel)/r;
+        if(d<1.f) trackMarks[z*textureSize+x]=std::max(trackMarks[z*textureSize+x],1.f-d*d);
+    }
+}
+void Simulation::moveTank(float drive,float steer,float dt,bool fast) {
+    if(paused) return;
+    dt=glm::clamp(dt,0.f,.05f);
+    glm::vec2 previous=tankPosition;
+    float previousYaw=tankYaw;
+    tankYaw+=steer*dt*1.7f;
+    glm::vec2 forward{std::cos(tankYaw),-std::sin(tankYaw)};
+    tankPosition+=forward*(drive*dt*(fast?6.f:3.5f));
+    tankPosition=glm::clamp(tankPosition,glm::vec2(-14.f),glm::vec2(14.f));
+    float distance=glm::length(tankPosition-previous);
+    if(distance<.0001f) return; // Apenas movimentar gera rastros.
+
+    // Amostras continuas para evitar falhas entre as duas trilhas, inclusive nas curvas.
+    int steps=std::max(1,int(std::ceil(distance/.07f)));
+    for(int i=0;i<=steps;i++) {
+        float t=float(i)/steps;
+        float angle=glm::mix(previousYaw,tankYaw,t);
+        glm::vec2 center=glm::mix(previous,tankPosition,t);
+        glm::vec2 lateral{std::sin(angle),std::cos(angle)};
+        paintTrack(center+lateral*1.f);
+        paintTrack(center-lateral*1.f);
+    }
+    tracksPending=true;
 }
