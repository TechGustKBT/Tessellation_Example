    <ClCompile Include="src\Renderer.cpp" />
    <ClCompile Include="src\Resources.cpp" />
    <ClCompile Include="src\Simulation.cpp" />
    <ClCompile Include="src\Swapchain.cpp" />
    <ClCompile Include="src\VulkanDevice.cpp" />
    <ClCompile Include="src\main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\Simulation.hpp" />
    <ClInclude Include="src\VulkanRenderer.hpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="shaders\common.glsl" />
    <None Include="shaders\tessellation.frag" />
    <None Include="shaders\tessellation.tesc" />
    <None Include="shaders\tessellation.tese" />
    <None Include="shaders\tessellation.vert" />
    <None Include="CONTROLES.txt" />
  </ItemGroup>
  <Target Name="CheckDependencies" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(SdkRoot)\Include\vulkan\vulkan.h')" Text="Vulkan SDK nao encontrado: verifique a pasta $(SdkRoot)\Include" />
    <Error Condition="!Exists('$(SdkRoot)\Lib\vulkan-1.lib')" Text="Biblioteca Vulkan nao encontrada: $(SdkRoot)\Lib\vulkan-1.lib" />
    <Error Condition="!Exists('$(VulkanDev)\glfw\include\GLFW\glfw3.h')" Text="GLFW nao encontrado: $(VulkanDev)\glfw\include\GLFW\glfw3.h" />
    <Error Condition="!Exists('$(VulkanDev)\glfw\lib-vc2022\glfw3.lib')" Text="Biblioteca GLFW nao encontrada: $(VulkanDev)\glfw\lib-vc2022\glfw3.lib" />
    <Error Condition="!Exists('$(VulkanDev)\glm\glm\glm.hpp')" Text="GLM nao encontrado: $(VulkanDev)\glm\glm\glm.hpp" />
  </Target>
  <Target Name="CompileShaders" AfterTargets="Build">
    <Error Condition="!Exists('$(SdkRoot)\Bin\glslc.exe')" Text="Compilador shader glslc.exe nao encontrado na pasta VulkanSDK\Bin" />
    <MakeDir Directories="$(TargetDir)shaders" />
    <Exec Command="&quot;$(SdkRoot)\Bin\glslc.exe&quot; --target-env=vulkan1.3 -I&quot;$(ProjectDir)shaders&quot; &quot;$(ProjectDir)shaders\tessellation.vert&quot; -o &quot;$(TargetDir)shaders\tessellation.vert.spv&quot;" />
    <Exec Command="&quot;$(SdkRoot)\Bin\glslc.exe&quot; --target-env=vulkan1.3 -I&quot;$(ProjectDir)shaders&quot; &quot;$(ProjectDir)shaders\tessellation.tesc&quot; -o &quot;$(TargetDir)shaders\tessellation.tesc.spv&quot;" />
    <Exec Command="&quot;$(SdkRoot)\Bin\glslc.exe&quot; --target-env=vulkan1.3 -I&quot;$(ProjectDir)shaders&quot; &quot;$(ProjectDir)shaders\tessellation.tese&quot; -o &quot;$(TargetDir)shaders\tessellation.tese.spv&quot;" />
    <Exec Command="&quot;$(SdkRoot)\Bin\glslc.exe&quot; --target-env=vulkan1.3 -I&quot;$(ProjectDir)shaders&quot; &quot;$(ProjectDir)shaders\tessellation.frag&quot; -o &quot;$(TargetDir)shaders\tessellation.frag.spv&quot;" />
    <Copy SourceFiles="$(ProjectDir)CONTROLES.txt" DestinationFolder="$(TargetDir)" />

	  <MakeDir Directories="$(TargetDir)assets" />

	  <Copy
		SourceFiles="$(ProjectDir)assets\Abrams_Model.tasm;$(ProjectDir)assets\Abrams_BaseColor.rgba"
		DestinationFolder="$(TargetDir)assets"
		SkipUnchangedFiles="true" />

  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
    <PropertyGroup Label="UserMacros">
	    <VulkanDev>$(MSBuildProjectDirectory)\VulkanDev</VulkanDev>
    </PropertyGroup>
</Project>