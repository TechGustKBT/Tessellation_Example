  <PropertyGroup Label="UserMacros" />
<PropertyGroup>
	<VulkanDev>$(MSBuildProjectDirectory)\VulkanDev</VulkanDev>
	<SdkRoot>$(VulkanDev)\VulkanSDK</SdkRoot>
	<OutDir>$(ProjectDir)build\$(Platform)\$(Configuration)\</OutDir>
	<IntDir>$(ProjectDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
	<TargetName>eruption_simulator</TargetName>
	<LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
</PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>GLFW_INCLUDE_VULKAN;GLFW_INCLUDE_NONE;GLM_FORCE_RADIANS;GLM_FORCE_DEPTH_ZERO_TO_ONE;GLM_ENABLE_EXPERIMENTAL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(SdkRoot)\Include;$(VulkanDev)\glfw\include;$(VulkanDev)\glm;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(SdkRoot)\Lib;$(VulkanDev)\glfw\lib-vc2022;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>vulkan-1.lib;glfw3.lib;gdi32.lib;user32.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
